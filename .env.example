# Copy to .env (gitignored). This plugin needs no secrets.
# Add plain config or 1Password references (op://vault/item/field) here if a future script needs them.
# Run commands that need secrets with: op run -- <command>
APP_ENV=dev
# Only for the eval harness (docs/evals). Subscription token from `claude setup-token`,
# or an op:// reference. Leave empty if you do not run the evals.
SPIKE_EVALS_OAUTH_TOKEN=
