{
  "id": "root-layout",
  "stage": "poc-checkpoint",
  "set": "tune",
  "n_runs": 3,
  "description": "Older layout (POC.md and LOG.md at the root): the root exclusions keep the changed LOG.md out of uncommitted, and no poc-spec/ is created",
  "prompt": "/spike-loop:poc-checkpoint iterate",
  "fixture": "ck-root",
  "allowed_tools": [
    "Read",
    "Write",
    "Edit",
    "Glob",
    "Grep",
    "Bash(git *)",
    "Bash(date *)"
  ],
  "timeout_s": 300,
  "max_cost_usd": 0.75,
  "graders": [
    {
      "name": "one_closing_entry",
      "type": "file_regex",
      "path": "LOG.md",
      "pattern": "^## \\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2} ",
      "flags": "m",
      "count": 3
    },
    {
      "name": "decision_names_outcome",
      "type": "file_regex",
      "path": "LOG.md",
      "pattern": "^- Decision: iterate\\b",
      "flags": "m",
      "count": 1
    },
    {
      "name": "state_line_is_the_last_line",
      "type": "file_regex",
      "path": "LOG.md",
      "pattern": "\\n- State: branch: main; at: [0-9a-f]{7,40}; uncommitted: none; unmerged worktrees: none; waiting on you: [^;\\n]+; resume: (?![^;\\n]*(/clear|poc-help))[^;\\n]+\\n*\\Z",
      "flags": "",
      "count": 1
    },
    {
      "name": "earlier_entries_byte_identical",
      "type": "file_prefix_unchanged",
      "path": "LOG.md"
    },
    {
      "name": "only_expected_files_changed",
      "type": "no_tracked_file_modified",
      "except": [
        "LOG.md"
      ]
    },
    {
      "name": "nothing_committed_or_staged",
      "type": "git_clean_history"
    },
    {
      "name": "no_em_dash_in_written_files",
      "type": "no_em_dash",
      "target": "changed"
    },
    {
      "name": "no_em_dash_in_reply",
      "type": "no_em_dash",
      "target": "final_text"
    },
    {
      "name": "no_poc_spec_created",
      "type": "file_exists",
      "path": "poc-spec",
      "exists": false
    },
    {
      "name": "no_summary_md",
      "type": "file_exists",
      "path": "SUMMARY.md",
      "exists": false
    },
    {
      "name": "next_is_clear_then_help",
      "type": "final_text_regex",
      "pattern": "^Next: .*/clear.*/spike-loop:poc-help",
      "flags": "m",
      "min": 1
    }
  ]
}
