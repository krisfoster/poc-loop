{
  "id": "stop",
  "stage": "poc-checkpoint",
  "set": "tune",
  "n_runs": 3,
  "description": "stop: closing entry, resume says the PoC is closed, SUMMARY.md written within 25 lines, no /clear",
  "prompt": "/spike-loop:poc-checkpoint stop",
  "fixture": "ck-base",
  "allowed_tools": [
    "Read",
    "Write",
    "Edit",
    "Glob",
    "Grep",
    "Bash(git *)",
    "Bash(date *)"
  ],
  "timeout_s": 300,
  "max_cost_usd": 0.75,
  "graders": [
    {
      "name": "one_closing_entry",
      "type": "file_regex",
      "path": "poc-spec/LOG.md",
      "pattern": "^## \\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2} ",
      "flags": "m",
      "count": 3
    },
    {
      "name": "decision_names_outcome",
      "type": "file_regex",
      "path": "poc-spec/LOG.md",
      "pattern": "^- Decision: stop\\b",
      "flags": "m",
      "count": 1
    },
    {
      "name": "state_line_is_the_last_line",
      "type": "file_regex",
      "path": "poc-spec/LOG.md",
      "pattern": "\\n- State: branch: main; at: [0-9a-f]{7,40}; uncommitted: none; unmerged worktrees: none; waiting on you: [^;\\n]+; resume: none, the PoC is closed\\.?\\n*\\Z",
      "flags": "",
      "count": 1
    },
    {
      "name": "earlier_entries_byte_identical",
      "type": "file_prefix_unchanged",
      "path": "poc-spec/LOG.md"
    },
    {
      "name": "only_expected_files_changed",
      "type": "no_tracked_file_modified",
      "except": [
        "poc-spec/LOG.md",
        "SUMMARY.md"
      ]
    },
    {
      "name": "nothing_committed_or_staged",
      "type": "git_clean_history"
    },
    {
      "name": "no_em_dash_in_written_files",
      "type": "no_em_dash",
      "target": "changed"
    },
    {
      "name": "no_em_dash_in_reply",
      "type": "no_em_dash",
      "target": "final_text"
    },
    {
      "name": "summary_md_written",
      "type": "file_exists",
      "path": "SUMMARY.md",
      "exists": true
    },
    {
      "name": "summary_within_25_lines",
      "type": "line_cap",
      "path": "SUMMARY.md",
      "max_lines": 25
    },
    {
      "name": "no_handoff_file",
      "type": "files_matching",
      "glob": "poc-spec/handoffs/*",
      "count": 0
    },
    {
      "name": "next_has_no_clear",
      "type": "final_text_regex",
      "pattern": "^Next: [^\\n]*/clear",
      "flags": "m",
      "count": 0
    }
  ]
}
