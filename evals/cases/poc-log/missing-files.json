{
  "id": "missing-files",
  "stage": "poc-log",
  "set": "tune",
  "n_runs": 3,
  "description": "No PoC documents: stops, writes nothing, and points at poc-start",
  "prompt": "/spike-loop:poc-log Tried an HMAC known vector. Learned the signature matches. Dead ends: none. Decision: none yet.",
  "fixture": "poc-log-empty",
  "allowed_tools": [
    "Read",
    "Edit",
    "Write",
    "Bash(date *)",
    "Bash(git *)"
  ],
  "timeout_s": 240,
  "max_cost_usd": 0.25,
  "graders": [
    {
      "name": "next_is_poc_start",
      "type": "final_text_regex",
      "pattern": "^Next: .*?/spike-loop:poc-start",
      "flags": "m",
      "min": 1
    },
    {
      "name": "no_new_log",
      "type": "file_exists",
      "path": "poc-spec/LOG.md",
      "exists": false
    },
    {
      "name": "no_root_log",
      "type": "file_exists",
      "path": "LOG.md",
      "exists": false
    },
    {
      "name": "nothing_written",
      "type": "no_tracked_file_modified",
      "allow_new": false
    }
  ]
}
