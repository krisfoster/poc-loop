{
  "id": "started-no-time",
  "stage": "poc-log",
  "set": "tune",
  "n_runs": 3,
  "description": "Started has a date and no time: the time check still runs (it uses the first log entry's time)",
  "prompt": "/spike-loop:poc-log Tried an HMAC known vector. Learned the signature matches. Dead ends: none. Decision: none yet.",
  "fixture": "poc-log-notime",
  "allowed_tools": [
    "Read",
    "Edit",
    "Write",
    "Bash(date *)",
    "Bash(git *)"
  ],
  "timeout_s": 240,
  "max_cost_usd": 0.25,
  "graders": [
    {
      "name": "dated_entries",
      "type": "file_regex",
      "path": "poc-spec/LOG.md",
      "pattern": "^## \\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2} ",
      "flags": "m",
      "count": 2
    },
    {
      "name": "shows_the_script_values_2",
      "type": "final_text_regex",
      "pattern": "(\\b\\d+h \\d+m|\\b\\d+m)\\b[^\\n]*?\\b2\\ hours\\b[^\\n]*?\\b2 entries\\b",
      "flags": "m",
      "min": 1
    },
    {
      "name": "earlier_entries_byte_identical",
      "type": "file_prefix_unchanged",
      "path": "poc-spec/LOG.md"
    },
    {
      "name": "no_em_dash_in_log",
      "type": "no_em_dash",
      "path": "poc-spec/LOG.md"
    },
    {
      "name": "no_em_dash_in_reply",
      "type": "no_em_dash",
      "target": "final_text"
    },
    {
      "name": "no_state_line",
      "type": "file_regex",
      "path": "poc-spec/LOG.md",
      "pattern": "^- State:",
      "flags": "m",
      "count": 0
    },
    {
      "name": "only_the_log_changed",
      "type": "no_tracked_file_modified",
      "except": [
        "poc-spec/LOG.md"
      ]
    },
    {
      "name": "ends_with_next",
      "type": "final_text_regex",
      "pattern": "^Next: ",
      "flags": "m",
      "min": 1
    },
    {
      "name": "ran_the_prereq_check",
      "type": "tool_call_count",
      "tool": "Bash",
      "input_regex": "check-prereqs",
      "min": 1
    },
    {
      "name": "ran_the_time_check_script",
      "type": "tool_call_count",
      "tool": "Bash",
      "input_regex": "time_check\\.py",
      "min": 1
    }
  ]
}
