{
  "id": "timebox-exceeded",
  "stage": "poc-log",
  "set": "tune",
  "n_runs": 3,
  "description": "Started two days before any run with a 2 hour timebox: says it is over and the Next line points at a checkpoint decision",
  "prompt": "/spike-loop:poc-log Tried an HMAC known vector. Learned the signature matches. Dead ends: none. Decision: none yet.",
  "fixture": "poc-log-specs",
  "allowed_tools": [
    "Read",
    "Edit",
    "Write",
    "Bash(date *)",
    "Bash(git *)"
  ],
  "timeout_s": 240,
  "max_cost_usd": 0.25,
  "graders": [
    {
      "name": "dated_entries",
      "type": "file_regex",
      "path": "poc-spec/LOG.md",
      "pattern": "^## \\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2} ",
      "flags": "m",
      "count": 2
    },
    {
      "name": "time_check_line_counts_2",
      "type": "final_text_regex",
      "pattern": "^Elapsed [^\\n]+ of [^\\n]+, 2 entr(y|ies)\\.$",
      "count": 1,
      "flags": "m"
    },
    {
      "name": "says_over",
      "type": "final_text_regex",
      "pattern": "(?i)\\b(exceed|over|past|beyond)",
      "min": 1
    },
    {
      "name": "next_is_a_checkpoint",
      "type": "final_text_regex",
      "pattern": "^Next: .*?/spike-loop:poc-checkpoint",
      "flags": "m",
      "min": 1
    },
    {
      "name": "earlier_entries_byte_identical",
      "type": "file_prefix_unchanged",
      "path": "poc-spec/LOG.md"
    },
    {
      "name": "no_em_dash_in_log",
      "type": "no_em_dash",
      "path": "poc-spec/LOG.md"
    },
    {
      "name": "no_em_dash_in_reply",
      "type": "no_em_dash",
      "target": "final_text"
    },
    {
      "name": "no_state_line",
      "type": "file_regex",
      "path": "poc-spec/LOG.md",
      "pattern": "^- State:",
      "flags": "m",
      "count": 0
    },
    {
      "name": "only_the_log_changed",
      "type": "no_tracked_file_modified",
      "except": [
        "poc-spec/LOG.md"
      ]
    },
    {
      "name": "ends_with_next",
      "type": "final_text_regex",
      "pattern": "^Next: ",
      "flags": "m",
      "min": 1
    }
  ]
}
